# Mode: bot, api, или all
MODE=all

# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Database
# Для локальной разработки (SQLite)
DATABASE_URL=sqlite+aiosqlite:///data/sendvpn.db
# Для продакшена (PostgreSQL на Render.com)
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# API Server
PORT=8000

# Parser Settings
PARSER_INTERVAL=3600  # seconds
MAX_SERVERS_PER_PROTOCOL=100
SERVER_CHECK_TIMEOUT=10

# Payment Settings (optional)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
STRIPE_API_KEY=your_stripe_key

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/sendvpn.log

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0
